VITE_APP_NAME=NEXUS PROPERTY NETWORK
VITE_APP_ENV=development

# Server-only model configuration. Never add the VITE_ prefix to these values.
NEXUS_GEMINI_API_KEY=
NEXUS_GEMINI_MODEL=gemini-2.5-flash
NEXUS_AGENT_RUN_TOKEN=

# Supabase browser client: use the project URL and publishable (or legacy anon) key only.
# Never add a service-role key to a VITE_ variable or any browser-exposed setting.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Server-only: required only for durable agent activity storage; never expose to the browser.
NEXUS_SUPABASE_URL=https://<project-ref>.supabase.co
NEXUS_SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
# Legacy server-only alias accepted by the agent activity endpoint.
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=86400
REFRESH_TOKEN_SECRET=
VITE_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Email
VITE_EMAIL_PROVIDER=console
VITE_EMAIL_FROM=no-reply@nexus.local

# Storage
VITE_STORAGE_BUCKET=property-images

# Payments
VITE_PAYMENT_PROVIDER=sandbox
VITE_PAYMENT_CALLBACK_URL=http://localhost:5173/api/payments/callback
VITE_PAYMENT_CALLBACK_API_URL=http://localhost:5173/api/payments/verify-callback
VITE_JAZZCASH_SANDBOX_URL=https://sandbox.jazzcash.com.pk/payment
VITE_EASYPAISA_SANDBOX_URL=https://sandbox.easypaisa.com.pk/payment
STRIPE_SECRET_KEY=

# WhatsApp
VITE_WHATSAPP_PROVIDER=none
WHATSAPP_TOKEN=

# App
VITE_API_BASE_URL=http://localhost:5173/api
VITE_ENABLE_REAL_BACKEND=false
