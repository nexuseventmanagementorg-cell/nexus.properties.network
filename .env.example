VITE_APP_NAME=NEXUS PROPERTY NETWORK
VITE_APP_ENV=development

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
VITE_JWT_SECRET=replace-me-with-production-secret
VITE_JWT_EXPIRES_IN=86400
VITE_REFRESH_TOKEN_SECRET=replace-me-with-refresh-secret
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Email
VITE_EMAIL_PROVIDER=console
VITE_EMAIL_FROM=no-reply@nexus.local

# Storage
VITE_STORAGE_BUCKET=property-images

# Payments
VITE_PAYMENT_PROVIDER=sandbox
VITE_PAYMENT_CALLBACK_URL=http://localhost:5173/api/payments/callback
VITE_PAYMENT_CALLBACK_API_URL=http://localhost:5173/api/payments/verify-callback
VITE_JAZZCASH_SANDBOX_URL=https://sandbox.jazzcash.com.pk/payment
VITE_EASYPAISA_SANDBOX_URL=https://sandbox.easypaisa.com.pk/payment
VITE_STRIPE_SECRET_KEY=replace-me

# WhatsApp
VITE_WHATSAPP_PROVIDER=none
VITE_WHATSAPP_TOKEN=replace-me

# App
VITE_API_BASE_URL=http://localhost:5173/api
VITE_ENABLE_REAL_BACKEND=false
